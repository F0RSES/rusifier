{
  "$schema": "https://unifypy.dev/schemas/build.schema.json",
  "name": "TermRu",
  "package": "termru",
  "display_name": "TermRu",
  "version": "0.2.0",
  "entry": "termru_gui_entry.py",
  "publisher": "TermRu contributors",
  "description": "Замена англицизмов в документах DOCX/PPTX/PDF",
  "icon": "packaging/icon.png",
  "license": "LICENSE",
  "onefile": false,
  "pyinstaller": {
    "additional_hooks_dir": ["packaging/hooks"],
    "add_data": [
      "data/glossary.json:data",
      "data/exceptions.json:data",
      "data/fonts:data/fonts",
      "prompts/system_prompt.txt:prompts"
    ],
    "hidden_import": [
      "polydoc",
      "pdf_edit_engine",
      "openai",
      "docx",
      "pptx",
      "mammoth",
      "html2docx",
      "qdarkstyle",
      "qtawesome",
      "PySide6.QtSvg",
      "PySide6.QtPrintSupport"
    ],
    "exclude_module": [
      "onnxruntime",
      "numpy",
      "pymupdf",
      "fitz",
      "pymupdf_layout",
      "pymupdf4llm",
      "pdfplumber",
      "rapidocr_onnxruntime",
      "pytesseract",
      "tkinter",
      "matplotlib",
      "IPython",
      "jupyter",
      "notebook",
      "polydoc.formats.readers.plaintext",
      "polydoc.formats.readers.markdown",
      "polydoc.formats.readers.html",
      "polydoc.formats.readers.json_native",
      "polydoc.formats.readers.delimited",
      "polydoc.formats.readers.xlsx",
      "polydoc.formats.writers.plaintext",
      "polydoc.formats.writers.markdown",
      "polydoc.formats.writers.html",
      "polydoc.formats.writers.json_native",
      "polydoc.formats.writers.delimited",
      "polydoc.formats.writers.xlsx",
      "PySide6.QtWebEngineCore",
      "PySide6.QtWebEngineWidgets",
      "PySide6.QtWebEngineQuick",
      "PySide6.QtMultimedia",
      "PySide6.QtMultimediaWidgets",
      "PySide6.QtSpatialAudio",
      "PySide6.QtTextToSpeech",
      "PySide6.Qt3DCore",
      "PySide6.Qt3DRender",
      "PySide6.Qt3DAnimation",
      "PySide6.Qt3DInput",
      "PySide6.Qt3DLogic",
      "PySide6.Qt3DExtras",
      "PySide6.QtCharts",
      "PySide6.QtDataVisualization",
      "PySide6.QtGraphs",
      "PySide6.QtGraphsWidgets",
      "PySide6.QtQuick",
      "PySide6.QtQuickWidgets",
      "PySide6.QtQuickControls2",
      "PySide6.QtQml",
      "PySide6.QtQmlModels",
      "PySide6.QtBluetooth",
      "PySide6.QtNfc",
      "PySide6.QtPositioning",
      "PySide6.QtLocation",
      "PySide6.QtSql",
      "PySide6.QtTest",
      "PySide6.QtDesigner",
      "PySide6.QtUiTools",
      "PySide6.QtHelp",
      "PySide6.QtSerialPort",
      "PySide6.QtSerialBus",
      "PySide6.QtWebSockets",
      "PySide6.QtWebChannel",
      "PySide6.QtHttpServer",
      "PySide6.QtRemoteObjects",
      "PySide6.QtScxml",
      "PySide6.QtStateMachine",
      "PySide6.QtSensors",
      "PySide6.QtPdf",
      "PySide6.QtPdfWidgets"
    ]
  },
  "platforms": {
    "windows": {
      "formats": ["exe"],
      "windowed": true
    },
    "linux": {
      "formats": ["deb"],
      "deb": {
        "create_desktop_file": false
      }
    }
  }
}
